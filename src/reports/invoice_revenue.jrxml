<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pawzenix report 2: Invoice revenue & balances
  Data comes from ReportData.revenue(from, to): one row per bill LINE ITEM.
  Fields: id (bill id), date, customer, service, quantity, unit_price, line_total, status
  The rows are grouped by bill id, so every invoice gets a header, its items and a total.
  Parameters are filled in by ReportController: FROM_DATE, TO_DATE, GENERATED_AT
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice_revenue" pageWidth="595" pageHeight="842" columnWidth="523"
              leftMargin="36" rightMargin="36" topMargin="30" bottomMargin="30"
              whenNoDataType="NoDataSection">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8"/>
    <style name="StatusColour" forecolor="#1F2A27">
        <conditionalStyle>
            <conditionExpression><![CDATA["Paid".equals($F{status})]]></conditionExpression>
            <style forecolor="#187565" isBold="true"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["Unpaid".equals($F{status})]]></conditionExpression>
            <style forecolor="#C0392B" isBold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="FROM_DATE" class="java.lang.String"/>
    <parameter name="TO_DATE" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>

    <field name="id" class="java.lang.Integer"/>
    <field name="date" class="java.lang.String"/>
    <field name="customer" class="java.lang.String"/>
    <field name="service" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="line_total" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>

    <!-- total of ONE invoice: starts again at zero for every new invoice (group) -->
    <variable name="invoiceTotal" class="java.math.BigDecimal" resetType="Group" resetGroup="Invoice" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
    </variable>
    <!-- totals for the whole report -->
    <variable name="billedTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
    </variable>
    <variable name="paidTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA["Paid".equals($F{status}) ? $F{line_total} : java.math.BigDecimal.ZERO]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="unpaidTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA["Unpaid".equals($F{status}) ? $F{line_total} : java.math.BigDecimal.ZERO]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="invoiceCount" class="java.lang.Integer" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{id}]]></variableExpression>
    </variable>

    <group name="Invoice" keepTogether="true">
        <groupExpression><![CDATA[$F{id}]]></groupExpression>
        <groupHeader>
            <band height="28">
                <rectangle>
                    <reportElement x="0" y="4" width="523" height="22" backcolor="#E4EFE9" forecolor="#E4EFE9"/>
                    <graphicElement><pen lineWidth="0.0"/></graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="6" y="4" width="92" height="22" forecolor="#143E35"/>
                    <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Invoice #" + $F{id}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="100" y="4" width="72" height="22"/>
                    <textElement verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="176" y="4" width="240" height="22"/>
                    <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement style="StatusColour" x="420" y="4" width="97" height="22"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="30">
                <line><reportElement x="263" y="2" width="258" height="1" forecolor="#187565"/></line>
                <staticText>
                    <reportElement x="263" y="5" width="150" height="18"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <text><![CDATA[Invoice total (LKR)]]></text>
                </staticText>
                <textField pattern="#,##0.00">
                    <reportElement x="413" y="5" width="106" height="18"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{invoiceTotal}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="100">
            <rectangle>
                <reportElement x="0" y="0" width="523" height="64" backcolor="#143E35" forecolor="#143E35"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="9" width="250" height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[Pawzenix]]></text>
            </staticText>
            <staticText>
                <reportElement x="16" y="38" width="250" height="16" forecolor="#AAC5B5"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <text><![CDATA[Pet care & veterinary centre]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="14" width="237" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Invoice revenue & balances]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="38" width="237" height="16" forecolor="#AAC5B5"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <text><![CDATA[Billed totals, collections and outstanding balances]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="72" width="330" height="18" forecolor="#1F2A27"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Invoice dates: " + $P{FROM_DATE} + " to " + $P{TO_DATE} + " (inclusive)"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="72" width="193" height="18" forecolor="#5C6B66"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="523" height="24" backcolor="#187565" forecolor="#187565"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="20" y="0" width="240" height="24" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Service]]></text></staticText>
            <staticText><reportElement x="263" y="0" width="48" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
            <staticText><reportElement x="313" y="0" width="100" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Unit price (LKR)]]></text></staticText>
            <staticText><reportElement x="413" y="0" width="106" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Line total (LKR)]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="20" y="0" width="240" height="18"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{service}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="263" y="0" width="48" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="313" y="0" width="100" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="413" y="0" width="106" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <line><reportElement x="0" y="2" width="523" height="1" forecolor="#C9D8D1"/></line>
            <staticText>
                <reportElement x="0" y="5" width="300" height="14" forecolor="#5C6B66"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <text><![CDATA[Pawzenix - Invoice revenue & balances report]]></text>
            </staticText>
            <textField>
                <reportElement x="323" y="5" width="147" height="14" forecolor="#5C6B66"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="473" y="5" width="50" height="14" forecolor="#5C6B66"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="150">
            <staticText>
                <reportElement positionType="Float" x="0" y="16" width="523" height="22" forecolor="#143E35"/>
                <textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Summary]]></text>
            </staticText>
            <line><reportElement positionType="Float" x="0" y="40" width="523" height="1" forecolor="#187565"/></line>

            <staticText><reportElement positionType="Float" x="0" y="46" width="240" height="18"/><textElement verticalAlignment="Middle"/><text><![CDATA[Invoices in this period]]></text></staticText>
            <textField><reportElement positionType="Float" x="240" y="46" width="130" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{invoiceCount}]]></textFieldExpression></textField>

            <staticText><reportElement positionType="Float" x="0" y="66" width="240" height="18"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Total billed (LKR)]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement positionType="Float" x="240" y="66" width="130" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{billedTotal}]]></textFieldExpression></textField>

            <staticText><reportElement positionType="Float" x="0" y="86" width="240" height="18" forecolor="#187565"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Collected - invoices marked Paid (LKR)]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement positionType="Float" x="240" y="86" width="130" height="18" forecolor="#187565"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{paidTotal}]]></textFieldExpression></textField>

            <staticText><reportElement positionType="Float" x="0" y="106" width="240" height="18" forecolor="#C0392B"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Outstanding - invoices marked Unpaid (LKR)]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement positionType="Float" x="240" y="106" width="130" height="18" forecolor="#C0392B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$V{unpaidTotal}]]></textFieldExpression></textField>
        </band>
    </summary>

    <noData>
        <band height="130">
            <rectangle>
                <reportElement x="0" y="0" width="523" height="64" backcolor="#143E35" forecolor="#143E35"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="9" width="250" height="28" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[Pawzenix]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="14" width="237" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Invoice revenue & balances]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="82" width="523" height="22" forecolor="#1F2A27"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["No invoices were found from " + $P{FROM_DATE} + " to " + $P{TO_DATE} + "."]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="104" width="523" height="16" forecolor="#5C6B66"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </noData>
</jasperReport>
